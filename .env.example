# Copy to `.env` and fill in. Validated at build/startup by src/env.ts —
# a missing or malformed value fails fast rather than crashing at runtime.

# Postgres connection string. This app uses Neon's serverless driver over
# WebSockets (interactive transactions are required for the claim logic), so
# point this at a Neon database — e.g. a free-tier project or dev branch.
# https://neon.tech
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Secret used by Auth.js to sign/encrypt the session JWT. Generate one with:
#   openssl rand -base64 33
AUTH_SECRET="replace-me-with-a-random-secret"
